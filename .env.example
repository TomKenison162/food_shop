# --- Database (Supabase Postgres) ---
# Get this from Supabase project settings -> Database -> Connection string (URI, "Transaction" pooler recommended)
DATABASE_URL="postgres://postgres:password@host:6543/postgres"

# --- Real grocery pricing (Pepesto, pay-as-you-go, costs real credits per call) ---
# Get a key by POSTing your Stripe checkout email to https://s.pepesto.com/api/link
PEPESTO_API_KEY=""
PEPESTO_BASE_URL="https://s.pepesto.com/api"
PEPESTO_SUPERMARKET_DOMAIN="sainsburys.co.uk"

# --- Email reminder (Resend) ---
# Optional. Without it, the 5pm cron route will run the rotation engine and log
# the selection but skip sending an email.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="dinner@yourdomain.com"
REMINDER_TO_EMAIL="you@example.com"

# --- Weather feature for the ML ranking model (Open-Meteo, no key needed) ---
WEATHER_LAT=""
WEATHER_LON=""

# --- Cron protection ---
# Any random string. Vercel Cron sends this as a Bearer token; set the same
# value in Vercel's Environment Variables. Generate with: openssl rand -hex 32
CRON_SECRET=""
